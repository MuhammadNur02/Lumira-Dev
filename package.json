{
  "name": "lumira",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:fixture-art": "node scripts/generate-fixture-art.mjs",
    "gen:springs": "node scripts/generate-spring-easings.mjs > src/styles/springs.css",
    "check:contrast": "node scripts/check-contrast.mjs",
    "env:local": "node scripts/env-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "ls:sync": "tsx --conditions=react-server --env-file=.env.local scripts/ls-sync.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "typegen": "pnpm --filter studio typegen",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@clerk/nextjs": "^7.9.4",
    "@clerk/ui": "^1.33.1",
    "@lumira/bento": "workspace:*",
    "@lumira/preview-bridge": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "@react-email/components": "^1.0.12",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.75.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.2.4",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "fumadocs-core": "^16.15.13",
    "fumadocs-mdx": "^15.4.3",
    "fumadocs-ui": "^16.15.13",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.434.9",
    "posthog-node": "^5.52.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "resend": "^6.28.1",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "svix": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  }
}
