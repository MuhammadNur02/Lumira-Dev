# Lumira environment template (Task.md §0.5). Copy to `.env.local` for development, or run
# `pnpm env:local`, which writes one with freshly generated secrets.
# Every variable is validated at boot by src/lib/env.ts; a missing or malformed value fails the build.
# Generate secrets with: openssl rand -base64 32

# ---------- App (public) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_ORIGIN_SUFFIX=lumira-demos.dev

# ---------- Content ----------
# `sanity` (default) reads the Content Lake. `fixtures` serves the seed catalog for local development
# before a Sanity project exists. Production refuses `fixtures`.
CONTENT_SOURCE=sanity

# ---------- Clerk ----------
# Optional in `next dev`: without keys, Clerk's keyless mode provisions temporary development keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Postgres (Supabase) ----------
# Runtime: Supavisor transaction pooler (port 6543) as role lumira_app. Local: postgresql://postgres:postgres@localhost:5432/lumira
DATABASE_URL=postgresql://lumira_app.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) as the owner. Used by drizzle-kit migrations in CI only.
DATABASE_URL_DIRECT=

# ---------- Sanity ----------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_URL=https://lumira.sanity.studio

# ---------- Lemon Squeezy ----------
LS_API_KEY=
LS_STORE_ID=
NEXT_PUBLIC_LS_STORE_SLUG=lumira
# 6–40 characters; the same value is entered in the LS webhook settings.
LS_WEBHOOK_SECRET=
LS_TEST_MODE=true
LS_FEE_PCT=5
LS_FEE_FIXED_CENTS=50

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_BUCKET=lumira-assets-staging
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=

# ---------- Resend ----------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Lumira <orders@mail.lumira.dev>"

# ---------- PostHog ----------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# ---------- Upstash (Redis + QStash) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------- Discord ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_STATE_SECRET=

# ---------- Lumira secrets (openssl rand -base64 32) ----------
LICENSE_ENCRYPTION_KEY=
LICENSE_HASH_PEPPER=
DOWNLOAD_TOKEN_SECRET=
GUEST_SCOPE_SECRET=
IP_HASH_SALT=
CRON_SECRET=

# ---------- Sentry ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# P8.01: report-only first; switch to "enforce" after 7 days without CSP reports
CSP_MODE=report-only
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Email routing (optional) ----------
EMAIL_FROM_NEWS="Lumira <releases@news.lumira.dev>"
ADMIN_ALERT_EMAIL=support@lumira.dev
SUPPORT_EMAIL=support@lumira.dev
